{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aiusage",
  "workers_dev": true,
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "cache": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aiusage-db",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  // Secrets are set via `wrangler secret put`:
  // - SITE_ID
  // - ENROLL_TOKEN
  // - DEVICE_TOKEN_SECRET
  // - PROJECT_NAME_SALT
  "vars": {
    "MAX_DEVICES": "10",
    "PUBLIC_PROJECT_VISIBILITY": "plain",
    "DEFAULT_TIMEZONE": "Asia/Shanghai"
  },
  "routes": [
    { "pattern": "aiusage.xdullboy.com", "custom_domain": true }
  ]
}
